+static void
+fp_select_os_cb (FpiDeviceRealtek *self,
+                 uint8_t          *buffer_in,
+                 GError           *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  /* 3274:9011 firmware requires a 4-step select_os handshake (params 0..3)
+   * before the template store becomes accessible. Re-enter the SELECT_OS
+   * state until all 4 steps have been sent. */
+  if (self->select_os_count < 3)
+    {
+      self->select_os_count++;
+      fpi_ssm_jump_to_state (self->task_ssm, FP_RTK_INIT_SELECT_OS);
+    }
+  else
+    {
+      fpi_ssm_next_state (self->task_ssm);
+    }
+}
+
 static void
 fp_init_sm_run_state (FpiSsm *ssm, FpDevice *device)
 {
@@ -1161,10 +1197,15 @@ fp_init_sm_run_state (FpiSsm *ssm, FpDevice *device)
       break;
 
     case FP_RTK_INIT_SELECT_OS:
-      co_select_system.param[0] = 0x01;
-      cmd_buf = (guint8 *) &co_select_system;
-      rtk_sensor_bulk_cmd (self, cmd_buf, NULL, FP_RTK_MSG_DEFAULT, 0, fp_task_ssm_generic_cb);
-      break;
+      {
+        GUsbDevice *usb_dev = fpi_device_get_usb_device (device);
+        gboolean handshake = (g_usb_device_get_pid (usb_dev) == 0x9011);
+        co_select_system.param[0] = handshake ? self->select_os_count : 0x01;
+        cmd_buf = (guint8 *) &co_select_system;
+        rtk_sensor_bulk_cmd (self, cmd_buf, NULL, FP_RTK_MSG_DEFAULT, 0,
+                             handshake ? fp_select_os_cb : fp_task_ssm_generic_cb);
+        break;
+      }
 
     case FP_RTK_INIT_GET_ENROLL_NUM:
       cmd_buf = (guint8 *) &co_get_enroll_num;
@@ -1320,6 +1361,8 @@ dev_init (FpDevice *device)
 
   g_assert (!self->task_ssm);
 
+  self->select_os_count = 0;
+
   self->task_ssm = fpi_ssm_new_full (device,
                                      fp_init_sm_run_state,
                                      FP_RTK_INIT_NUM_STATES,
